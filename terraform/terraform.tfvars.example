# GigaChad GRC Platform - Example Terraform Configuration
# Copy this file to terraform.tfvars and fill in the values below.
#
# Prerequisites before running terraform apply:
#   1. CloudFormation stack already deployed (creates S3 state bucket, DynamoDB table, ECR repos, IAM OIDC role)
#   2. ACM certificate issued in us-east-1 for your domain (or set enable_https = false initially)
#   3. GitHub Actions secrets/vars set: AWS_ROLE_ARN (secret), ECR_REGISTRY (var), AWS_REGION (var)
#   4. Push all 8 container images to ECR by triggering the GitHub Actions workflow

# General Configuration
project_name = "gigachad-grc"
environment  = "nprd"
aws_region   = "us-east-1"

# Network Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

# NAT Gateway (set single_nat_gateway = true to reduce cost for non-prod)
enable_nat_gateway = true
single_nat_gateway = false

# Security - restrict to your org's IP ranges
allowed_cidr_blocks = ["0.0.0.0/0"]  # CHANGE THIS: restrict to your office/VPN IPs in production

# SSL/TLS
enable_https        = true
ssl_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID"

# Database Configuration
rds_instance_class          = "db.t3.large"
rds_allocated_storage       = 100
rds_max_allocated_storage   = 500
rds_engine_version          = "16.1"
database_name               = "gigachad_grc"
database_username           = "grc_admin"
database_password           = "CHANGE_ME_STRONG_PASSWORD"
rds_backup_retention_period = 7
rds_multi_az                = true

# Redis Configuration
redis_node_type       = "cache.t3.medium"
redis_num_cache_nodes = 1
redis_engine_version  = "7.0"

# S3 Configuration
s3_enable_versioning = true

# ECS Configuration
ecs_service_desired_count = 2
ecs_task_cpu              = 1024
ecs_task_memory           = 2048

# Container Images
# Use your ECR registry URL (from CloudFormation outputs or AWS console)
# Format: ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com
container_registry = "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com"
image_tag          = "latest"

# Keycloak Configuration
# Keycloak runs as an ECS service at /auth on the same ALB as the frontend.
# Leave keycloak_url empty to auto-derive from ALB DNS (recommended),
# or set explicitly to your custom domain: "https://yourdomain.com/auth"
keycloak_url       = ""
keycloak_realm     = "gigachad-grc"
keycloak_client_id = "grc-services"

# Keycloak ECS sizing (Keycloak needs at least 512 CPU and 1024 MB)
keycloak_task_cpu      = 512
keycloak_task_memory   = 1024
keycloak_desired_count = 1

# -----------------------------------------------------------------------
# Sensitive secrets — use environment variables or a secrets backend
# instead of committing real values here.
# Generate with: openssl rand -hex 32  (for encryption_key)
#                openssl rand -base64 64 (for jwt_secret, session_secret)
#                openssl rand -hex 32  (for keycloak client secrets)
# -----------------------------------------------------------------------
keycloak_admin_password    = "CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD"
keycloak_client_secret     = "CHANGE_ME_GRC_SERVICES_CLIENT_SECRET"
keycloak_mcp_client_secret = "CHANGE_ME_GRC_MCP_CLIENT_SECRET"
jwt_secret                 = "CHANGE_ME_BASE64_JWT_SECRET"
encryption_key             = "CHANGE_ME_HEX_ENCRYPTION_KEY"
session_secret             = "CHANGE_ME_BASE64_SESSION_SECRET"

# CloudWatch alarm notifications (leave empty to disable)
alarm_email = ""
